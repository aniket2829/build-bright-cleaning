# Gmail SMTP for quote enquiries. Copy to .env.local and fill in.
# This file is committed, so it holds placeholders only — .env.local is
# gitignored and is the only place real values belong.

# The Gmail account the site sends *as*. Gmail rewrites the From header to
# this address, so it must be the account the app password belongs to.
SMTP_USER=you@gmail.com

# A 16-character Google App Password, NOT the account password.
# Google Account -> Security -> 2-Step Verification (must be on) -> App passwords.
# Paste it without spaces.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Where enquiries land. Optional: defaults to business.email in lib/content.ts.
QUOTE_INBOX=owner@example.com

# ---------------------------------------------------------------------------
# SEO and analytics
# ---------------------------------------------------------------------------

# The live origin, no trailing slash. Every canonical URL, the sitemap, robots.txt
# and the Open Graph tags are built from this, so it must be the exact domain you
# serve on — including whether you use www. Getting it wrong points every canonical
# at a domain that does not exist, which de-indexes the site.
#
# No NEXT_PUBLIC_ prefix on purpose: only server code reads it (lib/seo.ts, and
# the sitemap and robots routes), so it never needs to reach the browser.
SITE_URL=https://www.example.com

# GA4 measurement ID, from Google Analytics -> Admin -> Data streams -> your web
# stream. Starts with "G-". Leave unset in development and previews: with no ID,
# no analytics script is loaded at all, so local traffic never pollutes the
# production property.
#
# This one MUST keep the NEXT_PUBLIC_ prefix. It is read by a client component
# (components/analytics.tsx) and without the prefix it is undefined in the
# browser, so analytics silently never loads. Exposing it is correct and
# unavoidable: the ID is visible in the gtag URL every visitor's browser
# requests, on every GA-instrumented site on the web. It is an identifier, not
# a credential. If your host asks you to classify it, it is public config.
NEXT_PUBLIC_GA_ID=

# Search Console verification, only if you verify by the HTML tag method. Paste
# just the content value, not the whole <meta> tag. DNS verification is the more
# durable option and needs nothing here.
GOOGLE_SITE_VERIFICATION=
