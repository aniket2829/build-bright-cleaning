# Gmail SMTP for quote enquiries. Copy to .env.local and fill in.
# .env* is gitignored — never commit the real values.

# The Gmail account the site sends *as*. Gmail rewrites the From header to
# this address, so it must be the account the app password belongs to.
SMTP_USER=contact.aniketdhiman@gmail.com

# A 16-character Google App Password, NOT the account password.
# Google Account -> Security -> 2-Step Verification (must be on) -> App passwords.
# Paste it without spaces.
SMTP_PASSWORD=bgbofaonqgbxregh

# Where enquiries land. Optional: defaults to business.email in lib/content.ts.
QUOTE_INBOX=navneetlotey2000@gmail.com
